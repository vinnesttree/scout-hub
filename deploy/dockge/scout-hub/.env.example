# Copy to ".env" next to compose.yaml (or paste into Dockge's .env editor).

# TrueNAS dataset that holds everything. Two sub-folders are used:
#   <dataset>/data   -> database   (/data in the container)
#   <dataset>/media  -> recordings (/media in the container)
SCOUTHUB_DATASET=/mnt/ScoutData

# Owner of the dataset. 568 is TrueNAS's built-in "apps" user/group.
# Check with:  ls -ln /mnt/ScoutData
PUID=568
PGID=568

# Host port for the web UI -> http://<truenas-ip>:8000
SCOUTHUB_PORT=8000

# Branch / tag of github.com/vinnesttree/scout-hub to build.
SCOUTHUB_GIT_REF=main

TZ=America/Chicago

# Optional — can also be entered in Settings -> RobotEvents API.
SCOUTHUB_ROBOTEVENTS_TOKEN=
